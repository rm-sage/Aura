# Aura local environment variables.
#
# Copy this file to `.env.local` (which is gitignored) and fill in
# values for any integrations you want enabled in your local builds.
# Vite reads these automatically at build time via `loadEnv()` in
# vite.config.ts.
#
# Anything prefixed with VITE_ is also exposed to the running app via
# `import.meta.env.*`. Anything else is config-time only.

# ── Sentry (crash reporting) ────────────────────────────────────────────────
# DSN — used by main.tsx::Sentry.init AND src-tauri/src/lib.rs::run.
# Both sides only init when the user has consented via the first-run
# dialog (Settings → Crash Reporting). Same DSN works for both — Sentry
# accepts JS and Rust events on a single project.
VITE_SENTRY_DSN=
# Mirror of the above for the Rust side. Set to the same value.
SENTRY_DSN=

# ── Sentry source map upload (release builds only) ──────────────────────────
# All four of SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT must be set
# for the Sentry vite plugin to upload maps on `pnpm build` /
# `pnpm tauri build`. With any missing, the plugin is skipped and the
# build continues normally — useful for local-only debug builds.
SENTRY_AUTH_TOKEN=
# Slug of your Sentry organisation. Find it in the URL when you visit
# your dashboard: e.g. `https://sentry.io/organizations/YOUR-ORG/issues/`
# → `YOUR-ORG` is the slug.
SENTRY_ORG=
# Slug of the Sentry project. Find it in the URL when you visit a
# project: e.g. `https://sentry.io/organizations/YOUR-ORG/projects/aura/`
# → `aura` is the slug.
SENTRY_PROJECT=
# Sentry API host. Default `https://sentry.io/` for US-region orgs.
# EU-region orgs use `https://de.sentry.io/` (their DSNs end in
# `.ingest.de.sentry.io`).
SENTRY_URL=https://sentry.io/
