{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Aura main window. Scoped via both `windows` AND `webviews` so the IPC bridge is only granted to the main React webview — child popup webviews (label prefix `aura-source-popup-*`, used by SourcePopup.tsx for external sources and by the OAuth popup) load untrusted external HTTPS pages and must not be able to invoke any Tauri command. Without the explicit `webviews` field these child webviews would inherit the parent window's capabilities.",
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "shell:allow-open",
    "core:event:allow-listen",
    "core:window:allow-set-cursor-visible",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-create-webview",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-webview-close",
    "libmpv:default",
    "deep-link:default",
    "allow-load-video",
    "allow-player-controls",
    "allow-fetch-catalog",
    "allow-addon-manifest",
    "allow-addon-management",
    "allow-auth",
    "allow-global-search",
    "allow-cloud-sync",
    "allow-streaming-bridge",
    "allow-cinema-suite",
    "allow-meta-detail",
    "allow-library-sync",
    "allow-settings",
    "allow-scrobble",
    "allow-scrobble-auth",
    "allow-discord-rpc",
    "allow-subtitles",
    "allow-omdb-ratings",
    "allow-api-keys",
    "allow-aggregate-ratings",
    "allow-user-backups",
    "allow-smtc",
    "allow-stream-fetch",
    "allow-external-subtitles",
    "allow-per-title-state",
    "allow-stats",
    "allow-storage-management",
    "allow-aniskip",
    "allow-dev-tools",
    "allow-crash-reporting",
    "allow-sync",
    "allow-log-export",
    "updater:default"
  ]
}
