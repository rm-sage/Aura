{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Aura main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:event:allow-listen",
    "core:window:allow-set-cursor-visible",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "libmpv:default",
    "deep-link:default",
    "allow-load-video",
    "allow-player-controls",
    "allow-fetch-catalog",
    "allow-addon-manifest",
    "allow-addon-management",
    "allow-auth",
    "allow-global-search",
    "allow-cloud-sync",
    "allow-streaming-bridge",
    "allow-cinema-suite",
    "allow-meta-detail",
    "allow-library-sync",
    "allow-settings",
    "allow-scrobble",
    "allow-discord-rpc"
  ]
}
