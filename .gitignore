# ─── Dependencies / build ──────────────────────────────────────────────────
node_modules/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

dist/
build/
out/

# Rust
/target/
**/*.rs.bk
Cargo.lock
src-tauri/target/
src-tauri/binaries/
src-tauri/gen/
src-tauri/node_modules/

# ─── Closed-source helper crate ────────────────────────────────────────────
# aura-bridge lives in a separate private repo; the compiled binary is
# staged into src-tauri/target/{debug,release}/ at build time. The
# runtime spawn path in lib.rs handles a missing binary gracefully.
aura-bridge/

# ─── Environment / secrets ─────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Tauri auto-updater signing key — PRIVATE, never commit.
# The .pub counterpart is referenced from src-tauri/tauri.conf.json
# (plugins.updater.pubkey) and is safe to check in.
aura-updater.key
*.minisign.key
TAURI_SIGNING_*.key

# ─── Editors / OS ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.bak
*.tmp
*~
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs ──────────────────────────────────────────────────────────────────
logs/
*.log

# ─── AI assistants ─────────────────────────────────────────────────────────
.claude/
.gemini/
.gemini_security/
.cursor/

# ─── Internal planning artifacts (not part of the shipped product) ─────────
# conductor/ holds style guides, tracks, and product workflow docs from
# earlier development phases. Useful locally but don't belong in the
# repo of the shipped app.
conductor/

# ─── Local user-data backups ───────────────────────────────────────────────
# Manual snapshots created by the in-app Settings → Backups panel.
# Contain the user's library mirror, watched marks, history log, and
# AuraSettings — committed would leak personal state.
backups/
*.aura-backup.json

# ─── Upscaling shaders ─────────────────────────────────────────────────────
# Anime4K, FSRCNNX, RAVU, etc. are licensed separately and total tens
# of MB of GLSL across the supported chains. Users download once per
# clone per src-tauri/shaders/README.txt. The README is checked in;
# shader files themselves are not.
src-tauri/shaders/*.glsl
src-tauri/shaders/*.hook
!src-tauri/shaders/README.txt

# ─── Sentry build artifacts ────────────────────────────────────────────────
# .sentryclirc may carry org / project / token after `sentry-cli login`;
# Aura already reads those from .env.local but the CLI sometimes writes
# its own. Defensive ignore.
.sentryclirc
