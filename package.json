{
  "name": "aura",
  "private": true,
  "version": "0.6.10",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tsc:check": "tsc --noEmit",
    "build:analyze": "tsc && vite build --mode production && node ./scripts/bundle-report.cjs",
    "bundle:stage": "node ./scripts/stage-bridge.cjs",
    "bundle:release": "node ./scripts/stage-bridge.cjs && tauri build",
    "release": "pwsh ./scripts/release.ps1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^8.0.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@sentry/cli"],
    "ignoredBuiltDependencies": []
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.2.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
